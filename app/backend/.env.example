# Option A: local Docker Postgres (docker compose up -d in app/), no internet needed
DATABASE_URL="postgresql://agriai:agriai_dev_password@localhost:7002/agriai?schema=public"

# Option B: Supabase free tier (used for the hosted testing environment).
# Supabase's *direct* connection is IPv6-only and won't work on most networks —
# use the pooler instead, two modes:
#   DATABASE_URL = transaction mode, port 6543, add ?pgbouncer=true (app runtime)
#   DIRECT_URL   = session mode, port 5432, no pgbouncer flag (migrations only —
#                  transaction mode can't run the advisory locks/DDL migrations need)
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
PORT=7000

# Supabase Storage (case evidence photos/videos). SUPABASE_URL is
# https://<project-ref>.supabase.co — same project ref as DATABASE_URL
# above. SUPABASE_SERVICE_ROLE_KEY is from Supabase dashboard ->
# Settings -> API -> service_role key (full-access secret, never commit it).
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="change-me-service-role-key"
