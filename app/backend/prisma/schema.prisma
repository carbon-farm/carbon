// Stage 1 (Foundation): Identity & Membership, Farm/Land, Configuration
// taxonomy, Expert credentialing, and the Audit Trail.
// Stage 2 (Core Trust Loop): Case Management, Knowledge Repository
// publication workflow. Learning, Marketplace, and Soil Laboratory are
// still not modeled — see 01-Product/04-Product-Roadmap.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase transaction-mode pooler (6543) — app runtime
  directUrl = env("DIRECT_URL")   // Supabase session-mode pooler (5432) — migrations only;
                                   // transaction mode doesn't support the advisory locks and
                                   // DDL Prisma's migration engine needs
}

enum Role {
  FARMER
  EXPERT
  MODERATOR
  ADMINISTRATOR
  VENDOR
  SUPPORT_AGENT
}

enum MembershipStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum CredentialStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
}

// The ten states fixed in 000-Project-Charter.md's Case Lifecycle (v0.3.0).
// Knowledge Repository publication is deliberately NOT a Case status — it's a
// separate workflow triggered by Closed, per the Charter's own distinction.
enum CaseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  EXPERT_WORKING
  WAITING_FARMER
  ANSWERED
  FARMER_CONFIRMED
  REOPENED
  CLOSED
}

enum ClosureReason {
  RESOLVED
  ABANDONED
}

// Knowledge Repository publication workflow — deliberately separate from
// the Case Lifecycle (000-Project-Charter.md's own distinction): an
// article is reusable advisory content, not tied to one farmer's problem.
enum KnowledgeArticleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

model User {
  id                 String   @id @default(uuid())
  mobileNumber       String   @unique
  passwordHash       String
  role               Role
  name               String
  preferredLanguage  String   @default("te") // Telugu, per 01-Product/05-Target-Users.md
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Membership fields apply to FARMER role only; left nullable for other roles.
  membershipTier     String?
  membershipStatus   MembershipStatus?
  membershipExpiry   DateTime?

  farmLands          FarmLand[]
  expertProfile      ExpertProfile?
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]        @relation("AuditActor")
  verifiedExperts    ExpertProfile[]   @relation("CredentialVerifier")
  casesAsFarmer      Case[]            @relation("CaseFarmer")
  casesAsExpert      Case[]            @relation("CaseExpert")
  articlesAuthored   KnowledgeArticle[] @relation("KnowledgeAuthor")
  articlesReviewed   KnowledgeArticle[] @relation("KnowledgeReviewer")
  notifications      Notification[]
  articleFeedback    ArticleFeedback[]
  articleBookmarks   ArticleBookmark[]
  articleViews       ArticleView[]

  @@index([role])
}

// Farm/Land Parcel — its own entity per Charter v0.4.0: a farmer may operate more
// than one; Cases and Soil Reports (Stage 2+) link to the specific parcel, not the
// farmer generally.
model FarmLand {
  id             String   @id @default(uuid())
  farmerId       String
  farmer         User     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  label          String   // farmer-facing name, e.g. "North field"
  address        String
  landSizeAcres  Float
  primaryCrops   String[] // crop names, validated against CropMaster at the API layer
  latitude       Float?   // optional GPS pin, captured via the browser's Geolocation
  longitude      Float?   // API — easier for a farmer standing in the field than typing an address
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cases          Case[]

  @@index([farmerId])
}

// Module 4 — Case Management, modeled on CRM ticketing per Charter v0.3.0.
// caseNumber is farmer-visible and assigned at Submitted. isPriority +
// priorityConfirmedBy implement the confirmation-gated Emergency Advisory
// path (Charter v0.3.0) — a farmer requesting priority alone doesn't grant
// it, per the anti-abuse rule already in Section 9.1 of the Charter.
model Case {
  id                  String         @id @default(uuid())
  caseNumber          String?        @unique // set on Submitted, null while Draft

  farmerId            String
  farmer              User           @relation("CaseFarmer", fields: [farmerId], references: [id], onDelete: Cascade)
  farmLandId          String
  farmLand            FarmLand       @relation(fields: [farmLandId], references: [id], onDelete: Cascade)

  categoryId          String
  category            CaseCategoryMaster @relation(fields: [categoryId], references: [id])
  cropId              String?        // which crop the problem concerns — optional since
  crop                CropMaster?    @relation(fields: [cropId], references: [id]) // General Advisory
                                                                                     // cases aren't always about one

  problemDescription  String
  evidenceNotes       String?
  evidenceMediaUrls   String[]       @default([]) // Supabase Storage public URLs (photos/videos)

  status              CaseStatus     @default(DRAFT)
  closureReason       ClosureReason?

  assignedExpertId    String?
  assignedExpert      User?          @relation("CaseExpert", fields: [assignedExpertId], references: [id])

  priorityRequested   Boolean        @default(false) // the farmer's ask, alone, grants nothing
  isPriority          Boolean        @default(false) // true only after a Moderator/Administrator confirms — the actual anti-abuse gate
  priorityConfirmedBy String?        // userId of the Moderator/Administrator who confirmed it

  followUpQuestion    String?        // set when Expert Working -> Waiting Farmer
  followUpResponse    String?        // set when the farmer responds, before returning to Expert Working
  resolutionNotes     String?        // the expert's prescription/solution, set at Answered

  submittedAt         DateTime?
  closedAt            DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  knowledgeArticle    KnowledgeArticle?

  @@index([farmerId])
  @@index([assignedExpertId])
  @@index([status])
}

// Module 3 — Knowledge Repository. Per Charter Section 9.1: "Closed case ->
// Draft Article (auto-generated) -> Moderator Approval -> Published" — an
// article is never authored from scratch, only auto-created from a Closed
// (Resolved) case by CasesService.confirm(), then refined and submitted by
// the case's own expert. sourceCaseId is unique: at most one article per
// case, matching "a farmer's post-closure recurrence is a new, linked
// Case" (Charter 9.1) rather than a second article for the same case.
//
// Deliberately NOT modeled yet, and not hidden: References, Products Used
// (needs Module 6 — Marketplace, which doesn't exist), and Related
// Articles (needs real search/similarity, also not built). `version` is a
// simple incrementing counter, not the immutable version history the
// Charter's "never overwritten" language implies — a real version table is
// a follow-up, not attempted half-built here.
model KnowledgeArticle {
  id                 String                 @id @default(uuid())
  sourceCaseId       String                 @unique
  sourceCase         Case                   @relation(fields: [sourceCaseId], references: [id], onDelete: Cascade)
  authorId           String                 // Created By — the case's assigned expert
  author             User                   @relation("KnowledgeAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  title              String
  cropId             String?
  crop               CropMaster?            @relation(fields: [cropId], references: [id])
  categoryId         String?
  category           CaseCategoryMaster?    @relation(fields: [categoryId], references: [id])
  symptoms           String?                // clinical framing, distinct from the farmer's own
                                              // problemDescription — left for the expert to add
  problemDescription String
  expertSolution     String
  evidenceMediaUrls  String[]               @default([])
  tags               TagMaster[]

  status             KnowledgeArticleStatus @default(DRAFT)
  rejectionReason    String?                // required in spirit when rejected; enforced in service
  reviewedByUserId   String?
  reviewedBy         User?                  @relation("KnowledgeReviewer", fields: [reviewedByUserId], references: [id])
  version            Int                    @default(1)
  publishedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  // Charter's cross-cutting Feedback utility (Section 10.1): "low-rated
  // content automatically routed to the Moderator review queue." Flagging
  // reuses the existing PUBLISHED->REJECTED->edit->resubmit loop rather than
  // inventing a new status — a moderator who acts on a flag just calls the
  // same sendBackForRevision path an ordinary rejection would use.
  flaggedForReview   Boolean                @default(false)
  flagReason         String?
  feedback           ArticleFeedback[]
  bookmarks          ArticleBookmark[]
  views              ArticleView[]

  @@index([authorId])
  @@index([status])
}

// Charter's cross-cutting Bookmarks utility (Section 10.1): "videos/
// articles/products/solutions" — only articles exist to bookmark today.
model ArticleBookmark {
  id        String           @id @default(uuid())
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([articleId, userId])
}

// Charter's cross-cutting Recently Viewed utility (Section 10.1). One row
// per (user, article) — a repeat view bumps viewedAt rather than growing the
// table unbounded, since "recently viewed" only ever needs the last handful.
model ArticleView {
  id        String           @id @default(uuid())
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt  DateTime         @default(now())

  @@unique([articleId, userId])
  @@index([userId, viewedAt])
}

model ArticleFeedback {
  id        String           @id @default(uuid())
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpful   Boolean
  rating    Int              // 1-5, enforced at the DTO layer
  comment   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([articleId, userId])
}

// Module 10 — Administration: expert credential verification is a precondition of
// Expert Portal activation, per Charter v0.4.0 / Risk R9 mitigation.
model ExpertProfile {
  id                 String            @id @default(uuid())
  userId             String            @unique
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualification      String? // null until the expert submits credentials (ExpertsService.submitCredentials)
  licenseNumber      String?
  credentialStatus   CredentialStatus  @default(NOT_SUBMITTED)
  verifiedByUserId   String?
  verifiedBy         User?             @relation("CredentialVerifier", fields: [verifiedByUserId], references: [id])
  verifiedAt         DateTime?
  submittedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model OtpVerification {
  id            String     @id @default(uuid())
  mobileNumber  String
  codeHash      String
  purpose       OtpPurpose
  expiresAt     DateTime
  consumed      Boolean    @default(false)
  attempts      Int        @default(0)
  createdAt     DateTime   @default(now())

  @@index([mobileNumber, purpose])
}

// --- Module 14: Configuration — the platform's single controlled taxonomy.
// Referenced by other modules, never duplicated, per Charter v0.3.0.

model CropMaster {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  cases     Case[]
  articles  KnowledgeArticle[]
}

model CaseCategoryMaster {
  id          String   @id @default(uuid())
  name        String   @unique // Disease, Pest, Nutrient Deficiency, Weather Damage,
                                // Unknown Problem, General Advisory/Planning (Charter v0.3.0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  cases       Case[]
  articles    KnowledgeArticle[]
}

model TagMaster {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  articles  KnowledgeArticle[]
}

model RegionMaster {
  id         String   @id @default(uuid())
  name       String
  state      String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([name, state])
}

// Cross-cutting: Audit Trail is a binding Charter principle from day one, not a
// Stage-5 hardening afterthought.
model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id])
  action      String   // e.g. "user.register", "expert.credential.verify"
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

// Module 12 — Notification. Charter specifies in-app, SMS, WhatsApp, email,
// and push channels; only in-app is buildable without a vendor decision
// (which SMS/WhatsApp/email provider, who pays) — same reasoning that put
// the on-screen "Temporary" OTP display in place ahead of real SMS delivery.
// linkPath is computed and stored at creation time by the triggering
// service, which already knows the recipient's role — simpler and more
// robust than the client trying to infer a route from entityType per role.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // e.g. "case.assigned", "article.rejected"
  title     String
  body      String
  linkPath  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
